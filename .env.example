# Copy to .env.local and fill in. .env.local is git-ignored by Next.js.

# Used by scripts/generate-questions.ts (Haiku question generation)
ANTHROPIC_API_KEY=sk-ant-...

# Used by scripts/embed-questions.ts (OpenAI text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Supabase Postgres connection string (server-side only — never exposed to the
# browser). Use the Transaction pooler URL (port 6543) for serverless. From the
# Supabase dashboard: Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth (email+password login). These two ARE exposed to the browser
# (that's expected for the anon key). From the Supabase dashboard:
# Project Settings → API → Project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
